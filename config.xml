<?xml version='1.0' encoding='utf-8'?>
<widget id="com.chitchat.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Chit Chat</name>
    <description>Chit Chat Android</description>
    <author email="" href="">Chit Chat</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xFFF0F4F8" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="GradlePluginKotlinEnabled" value="true" />
    <preference name="GradlePluginKotlinVersion" value="1.9.24" />
    <preference name="AndroidWindowSplashScreenAnimatedIcon" value="icons/icon112x112.png" />
    <preference name="AndroidPersistentFileLocation" value="Compatibility" />
    <platform name="android">
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <icon src="icons/icon56x56.png" />
        <icon density="ldpi" src="icons/icon56x56.png" />
        <icon density="mdpi" src="icons/icon56x56.png" />
        <icon density="hdpi" src="icons/icon112x112.png" />
        <icon density="xhdpi" src="icons/icon112x112.png" />
        <config-file parent="/manifest/application" target="AndroidManifest.xml">
            <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="ca-app-pub-4672720627282510~8007823774" />
        </config-file>
    </platform>
</widget>
